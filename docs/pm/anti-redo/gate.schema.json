{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS pre-assignment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "capability_ids",
    "main_sha",
    "head_pins",
    "lookups",
    "crosswalk",
    "owner",
    "owner_handoff",
    "later_decisions",
    "changed_seam",
    "proof",
    "tests_reused",
    "new_tests",
    "authority",
    "rollback",
    "overlap_review",
    "disposition"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "crosswalk": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "owner_handoff": {
      "type": "string",
      "minLength": 1
    },
    "changed_seam": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "overlap_review": {
      "type": "string",
      "minLength": 1
    },
    "capability_ids": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lookups": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "later_decisions": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests_reused": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "main_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "head_pins": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      }
    },
    "proof": {
      "enum": [
        "REAL_GAP",
        "REUSE_WITH_ADAPTER",
        "COVERED",
        "UNKNOWN",
        "DUPLICATE_OVERLAP"
      ]
    },
    "new_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assertion",
          "rationale",
          "invalidation"
        ],
        "additionalProperties": false,
        "properties": {
          "assertion": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "invalidation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "disposition": {
      "enum": [
        "BLOCKED_DUPLICATE_RISK",
        "ALREADY_COVERED",
        "CONNECT_EXISTING",
        "INVENTORY_REQUIRED",
        "PROCEED_TO_APPROVAL"
      ]
    }
  }
}
